    {
      "id": "4581ad14-3f6c-5b22-b88c-5229af5be539",
      "name": "Read page template",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "operation": "read",
