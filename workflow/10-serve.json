    {
      "id": "0fcdcee1-519f-5784-b91b-f4dd10e75d5d",
      "name": "Read page template",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "operation": "read",
